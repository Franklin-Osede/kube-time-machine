{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "kube-time-machine values",
  "description": "Rejects at `helm install` time the values that the agent would otherwise only reject at startup, turning a CrashLoopBackOff into an install error. Unknown keys are rejected too, so a typo fails instead of silently keeping the default.",
  "type": "object",
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "repository"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "description": "Mirrors cmd/agent validateConfig. Keep the two in step.",
      "properties": {
        "intervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Flush cadence. Must be > 0: the agent builds a time.Ticker from it."
        },
        "fullEvery": {
          "type": "integer",
          "minimum": 1,
          "description": "Every Nth flush is a full reference snapshot. Must be >= 1."
        },
        "burstThreshold": {
          "type": "integer",
          "minimum": 0,
          "description": "0 disables burst flushing. Negative is rejected."
        },
        "retainDays": {
          "type": "integer",
          "minimum": 0,
          "description": "0 keeps everything forever. Negative is rejected."
        }
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|k|Ei|Pi|Ti|Gi|Mi|Ki)?$",
          "description": "Kubernetes quantity, e.g. 10Gi."
        },
        "storageClassName": {
          "type": "string",
          "not": {
            "pattern": "^REPLACE_"
          },
          "description": "Empty uses the cluster default. A REPLACE_ placeholder (values-prod.yaml) is rejected so it cannot leave the PVC pending on a class that does not exist."
        },
        "retain": {
          "type": "boolean",
          "description": "Annotate the PVC with helm.sh/resource-policy: keep so `helm uninstall` does not destroy the recorded history."
        },
        "existingClaim": {
          "type": "string",
          "description": "Bind to an existing PVC instead of creating one. When set, no PVC is created and size/storageClassName/retain are ignored."
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "properties": {
        "health": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "additionalProperties": false
        },
        "excludeNamespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "watchResources": {
          "type": "array",
          "description": "Each entry must carry an explicit version: the dynamic client performs no discovery, so a version-less GVR never syncs and the pod hangs in WaitForCacheSync.",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9.]*[a-z0-9])?)?/[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          }
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "extraRules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "apiGroups": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "resources": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "verbs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "get",
                    "list",
                    "watch"
                  ]
                },
                "description": "Read-only only. The agent never writes, and a mutating verb here would silently widen a cluster-scoped role."
              }
            },
            "required": [
              "apiGroups",
              "resources",
              "verbs"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
